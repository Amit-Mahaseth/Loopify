# Music service example environment variables
# Copy to Backend/Music/.env and replace placeholder values. Never commit real secrets.

MONGO_URI=mongodb://localhost:27017/loopify_music
JWT_SECRET=changeme_super_secret
AWS_ACCESS_ID=AKIA...EXAMPLE
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
FRONTEND_URL=http://localhost:5173

# Notes:
# - The Music service uses AWS S3 for storage and expects a bucket named `loopify-bucket`.
# - Presigned read URLs created by the service expire after one hour.
# - Set FRONTEND_URL to the deployed frontend origin when using cross-origin API or Socket.IO access.
