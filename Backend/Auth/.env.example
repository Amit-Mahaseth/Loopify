# Auth service example environment variables
# Copy to Backend/Auth/.env and replace placeholder values. Never commit real secrets.

MONGO_URI=mongodb://localhost:27017/loopify_auth
JWT_SECRET=changeme_super_secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
RABBITMQ_URI=amqp://guest:guest@localhost:5672/
EMAIL_USER=your-email@example.com
GOOGLE_REFRESH_TOKEN=refresh-token-for-gmail-oauth

# Notes:
# - Auth reads these keys via src/config/config.js
# - The Google callback URL must match the Google Cloud OAuth2 client configuration
