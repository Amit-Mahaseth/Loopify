# Notification service example environment variables
# Copy to Backend/Notification/.env and replace placeholder values. Never commit real secrets.

JWT_SECRET=changeme_super_secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=refresh-token-for-gmail-oauth
EMAIL_USER=your-email@example.com
RABBITMQ_URI=amqp://guest:guest@localhost:5672/

# Notes:
# - Notification listens to RabbitMQ (user_registered) and sends welcome email.
# - Notification currently reads OAuth/Gmail config but does not perform OAuth login itself.
