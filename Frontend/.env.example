# Optional Vite development proxy targets.
# Defaults to localhost:3000 and localhost:3002 when running Vite on the host.
# In Docker Compose, these should use the service names (auth and music).

# Auth service proxy target
VITE_AUTH_API_URL=http://localhost:3000

# Music service proxy target
VITE_MUSIC_API_URL=http://localhost:3002
