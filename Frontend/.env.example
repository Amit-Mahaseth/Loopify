# Frontend environment example for Loopify (Vite)
# The current frontend codebase uses hard-coded proxy targets in vite.config.js
# and does not require environment variables to run in development with the repo layout.
# These values are optional helpers for deployments or to refactor the app to use env values.

# Base URL for the auth API (example)
VITE_API_AUTH_URL=http://localhost:3000

# Base URL for the music API (example)
VITE_API_MUSIC_URL=http://localhost:3002

# Example: override the public path for production build
# VITE_PUBLIC_PATH=/app/

# Note: Vite exposes variables prefixed with VITE_ to the client. Do not store secrets here.
